<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 进入「Shopify 导入」默认先看到导入记录（进度）；新建导入用列表上的按钮 -->
    <menuitem id="menu_shopify_import_root"
              name="Shopify 导入"
              sequence="95"
              groups="base.group_system"/>

    <menuitem id="menu_shopify_import_batch"
              name="导入记录"
              parent="menu_shopify_import_root"
              action="shopify_csv_import.action_shopify_import_batch"
              sequence="5"/>

    <menuitem id="menu_shopify_import_wizard"
              name="新建导入"
              parent="menu_shopify_import_root"
              action="shopify_csv_import.action_shopify_import_wizard"
              sequence="10"/>

    <menuitem id="menu_shopify_image_queue"
              name="图片同步队列"
              parent="menu_shopify_import_root"
              action="shopify_csv_import.action_shopify_image_queue"
              sequence="20"/>

</odoo>

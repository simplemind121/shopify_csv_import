<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate：你在后台改过的启停/间隔，模块升级时不会被覆盖回默认值 -->
    <data noupdate="1">

    <record id="ir_cron_shopify_image_sync" model="ir.cron">
        <field name="name">Shopify 图片同步</field>
        <field name="model_id" ref="model_shopify_image_queue"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending(limit=30)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <!-- 导入批次的商品导入阶段（上传 CSV 后会被立即触发，平时每分钟检查一次） -->
    <record id="ir_cron_shopify_import_batch" model="ir.cron">
        <field name="name">Shopify 导入批次</field>
        <field name="model_id" ref="model_shopify_import_batch"/>
        <field name="state">code</field>
        <field name="code">model._cron_run()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <!-- Shopify 链接失效（media_picker 的链接健康检查判定为 broken，或对账时返回 404）
         的图片，把前台显示换成对象存储的备份链接 -->
    <record id="ir_cron_shopify_image_failover" model="ir.cron">
        <field name="name">Shopify 图片失效切换</field>
        <field name="model_id" ref="model_shopify_image_queue"/>
        <field name="state">code</field>
        <field name="code">model._cron_failover()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    </data>
</odoo>

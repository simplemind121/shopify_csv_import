<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shopify_import_wizard_form" model="ir.ui.view">
        <field name="name">shopify.import.wizard.form</field>
        <field name="model">shopify.import.wizard</field>
        <field name="arch" type="xml">
            <form string="导入 Shopify 商品">
                <group>
                    <field name="csv_file" filename="csv_filename" string="Shopify 商品导出 CSV"/>
                    <field name="csv_filename" invisible="1"/>
                    <field name="media_source_id"/>
                    <field name="alist_upload_path_prefix" invisible="not media_source_id"/>
                </group>
                <div class="text-muted">
                    点「开始导入」后会建一个导入批次，商品和图片都在后台处理。
                    可以直接关掉页面，随时在「Shopify 导入 → 导入批次」查看进度。
                </div>
                <footer>
                    <button name="action_import" string="开始导入" type="object" class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopify_import_wizard" model="ir.actions.act_window">
        <field name="name">导入 Shopify 商品</field>
        <field name="res_model">shopify.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>

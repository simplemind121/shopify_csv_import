<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shopify_import_wizard_form" model="ir.ui.view">
        <field name="name">shopify.import.wizard.form</field>
        <field name="model">shopify.import.wizard</field>
        <field name="arch" type="xml">
            <form string="导入 Shopify 商品">
                <group invisible="state != 'draft'">
                    <field name="csv_file" filename="csv_filename" string="Shopify 商品导出 CSV"/>
                    <field name="csv_filename" invisible="1"/>
                    <field name="media_source_id"/>
                    <field name="alist_upload_path_prefix" invisible="not media_source_id"/>
                </group>
                <group string="导入结果" invisible="state != 'done'" col="4">
                    <field name="created_count" string="新建商品"/>
                    <field name="updated_count" string="更新商品"/>
                    <field name="error_count" string="失败商品"/>
                    <field name="image_queue_count" string="排队待同步图片"/>
                </group>
                <field name="import_log" readonly="1" invisible="not import_log"
                       widget="text" placeholder="导入日志会显示在这里"/>
                <footer>
                    <button name="action_import" string="开始导入" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_process_images_now" string="立即同步一批图片"
                            type="object" class="btn-secondary" invisible="state != 'done'"/>
                    <button string="关闭" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopify_import_wizard" model="ir.actions.act_window">
        <field name="name">导入 Shopify 商品</field>
        <field name="res_model">shopify.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
